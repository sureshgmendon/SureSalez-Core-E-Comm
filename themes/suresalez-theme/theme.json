{
  "$schema": "https://schemas.wp.org/trunk/theme.json",
  "version": 2,
  "settings": {
    "appearanceTools": true,
    "useRootPaddingAwareAlignments": true,
    "layout": {
      "contentSize": "1200px",
      "wideSize": "1440px"
    },
    "color": {
      "custom": true,
      "customDuotone": false,
      "customGradient": true,
      "defaultGradients": false,
      "defaultPalette": false,
      "palette": [
        {
          "slug": "primary",
          "color": "#0f172a",
          "name": "Primary Deep Slate"
        },
        {
          "slug": "primary-hover",
          "color": "#1e293b",
          "name": "Primary Hover"
        },
        {
          "slug": "accent",
          "color": "#3b82f6",
          "name": "Electric Blue Accent"
        },
        {
          "slug": "accent-light",
          "color": "#eff6ff",
          "name": "Accent Light"
        },
        {
          "slug": "success",
          "color": "#10b981",
          "name": "Success Green"
        },
        {
          "slug": "warning",
          "color": "#f59e0b",
          "name": "Warning Amber"
        },
        {
          "slug": "foreground",
          "color": "#0f172a",
          "name": "Foreground Text"
        },
        {
          "slug": "foreground-muted",
          "color": "#64748b",
          "name": "Muted Text"
        },
        {
          "slug": "background",
          "color": "#ffffff",
          "name": "Background Pure"
        },
        {
          "slug": "background-alt",
          "color": "#f8fafc",
          "name": "Subtle Background"
        },
        {
          "slug": "border-subtle",
          "color": "#e2e8f0",
          "name": "Subtle Border"
        }
      ]
    },
    "typography": {
      "fluid": true,
      "fontFamilies": [
        {
          "fontFamily": "Inter, -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif",
          "name": "Sans Serif (Inter)",
          "slug": "sans"
        },
        {
          "fontFamily": "'JetBrains Mono', Consolas, Monaco, monospace",
          "name": "Monospace",
          "slug": "mono"
        }
      ],
      "fontSizes": [
        {
          "name": "XS",
          "size": "0.75rem",
          "slug": "xs"
        },
        {
          "name": "Small",
          "size": "0.875rem",
          "slug": "small"
        },
        {
          "name": "Medium",
          "size": "1rem",
          "slug": "medium"
        },
        {
          "name": "Large",
          "size": "1.25rem",
          "slug": "large"
        },
        {
          "name": "XL",
          "size": "1.75rem",
          "slug": "xl"
        },
        {
          "name": "2XL",
          "size": "2.25rem",
          "slug": "2xl"
        },
        {
          "name": "3XL",
          "size": "3rem",
          "slug": "3xl"
        }
      ]
    },
    "spacing": {
      "units": ["px", "rem", "%", "vh", "vw"],
      "spacingScale": {
        "steps": 0
      },
      "spacingSizes": [
        {
          "name": "1",
          "size": "0.25rem",
          "slug": "20"
        },
        {
          "name": "2",
          "size": "0.5rem",
          "slug": "30"
        },
        {
          "name": "3",
          "size": "0.75rem",
          "slug": "40"
        },
        {
          "name": "4",
          "size": "1rem",
          "slug": "50"
        },
        {
          "name": "6",
          "size": "1.5rem",
          "slug": "60"
        },
        {
          "name": "8",
          "size": "2rem",
          "slug": "70"
        },
        {
          "name": "12",
          "size": "3rem",
          "slug": "80"
        }
      ]
    }
  },
  "styles": {
    "color": {
      "background": "var(--wp--preset--color--background)",
      "text": "var(--wp--preset--color--foreground)"
    },
    "typography": {
      "fontFamily": "var(--wp--preset--font-family--sans)",
      "fontSize": "var(--wp--preset--font-size--medium)",
      "lineHeight": "1.6"
    },
    "elements": {
      "button": {
        "color": {
          "background": "var(--wp--preset--color--primary)",
          "text": "#ffffff"
        },
        "border": {
          "radius": "8px"
        },
        "spacing": {
          "padding": {
            "top": "0.75rem",
            "bottom": "0.75rem",
            "left": "1.5rem",
            "right": "1.5rem"
          }
        },
        "typography": {
          "fontWeight": "600",
          "fontSize": "0.9375rem"
        }
      },
      "link": {
        "color": {
          "text": "var(--wp--preset--color--accent)"
        },
        ":hover": {
          "color": {
            "text": "var(--wp--preset--color--primary)"
          }
        }
      },
      "h1": {
        "typography": {
          "fontSize": "var(--wp--preset--font-size--3-xl)",
          "fontWeight": "800",
          "lineHeight": "1.2"
        }
      },
      "h2": {
        "typography": {
          "fontSize": "var(--wp--preset--font-size--2-xl)",
          "fontWeight": "700",
          "lineHeight": "1.25"
        }
      },
      "h3": {
        "typography": {
          "fontSize": "var(--wp--preset--font-size--xl)",
          "fontWeight": "600",
          "lineHeight": "1.3"
        }
      }
    }
  }
}
